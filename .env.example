# Development-only credentials for the local docker-compose database.
# Copy to backend/.env when running locally. Never commit real secrets.
DATABASE_URL=postgresql+psycopg://rent:rent@localhost:5433/rent
POSTGRES_USER=rent
POSTGRES_PASSWORD=rent
POSTGRES_DB=rent

# Firebase Auth. Local development uses the Auth Emulator (see firebase.json);
# no real Firebase project or credentials are needed for the emulator.
FIREBASE_PROJECT_ID=demo-apun-ghar
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Production only: path to a service-account JSON file. Never commit the file
# or real values. Leave unset for local emulator development.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Listing photo storage (Backblaze B2, S3-compatible, private bucket).
# Copy real values into backend/.env (gitignored). Never commit real
# credentials. The browser only ever receives short-lived presigned URLs.
B2_ENDPOINT_URL=https://s3.us-east-005.backblazeb2.com
B2_BUCKET_NAME=apun-ghar-listing-photos
B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=
# Optional overrides (defaults shown):
# B2_REGION=us-east-005
# B2_UPLOAD_EXPIRES_IN=900
# B2_VIEW_EXPIRES_IN=3600
