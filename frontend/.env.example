# Local development defaults. Copy to `.env.local` and fill in real
# values when pointing at a production Firebase project.
# Never commit real secrets; `.env.local` is gitignored by Next.js default.

# FastAPI backend base URL (no trailing slash).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# "true" routes Firebase Auth to the local Auth Emulator (see firebase.json
# at the repository root). Set to "false" for real Firebase projects.
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true

# Host:port of the local Auth Emulator.
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Public Firebase web config. Empty values fall back to the local
# demo/emulator project. Only these NEXT_PUBLIC_ values are exposed
# to the browser; service-account credentials must never go here.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-apun-ghar
NEXT_PUBLIC_FIREBASE_APP_ID=
